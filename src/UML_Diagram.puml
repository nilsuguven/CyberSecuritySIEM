
@startuml Cybersecurity SIEM System

skinparam classAttributeIconSize 0
hide empty members

package model {
    enum SeverityLevel {
        LOW
        MEDIUM
        HIGH
        CRITICAL
        --
        - final int level
        - SeverityLevel(int level)
        + int getLevel()
    }

    class LogEntry {
        - String id
        - String sourceIp
        - String message
        - String logType
        - LocalDateTime timestamp
        --
        + LogEntry(String id, String sourceIp, String message, String logType)
        + LogEntry(String sourceIp, String message)
        + String getId()
        + String getSourceIp()
        + String getMessage()
        + String getLogType()
        + LocalDateTime getTimestamp()
    }

    class Incident {
        - String id
        - String title
        - String sourceIp
        - SeverityLevel severity
        - int threatScore
        - String status
        - LocalDateTime timestamp
        --
        + Incident(String id, String title, String sourceIp, SeverityLevel severity, int threatScore)
        + Incident(String id, String title, String sourceIp, SeverityLevel severity, int threatScore, String status, LocalDateTime timestamp)
        + String getId()
        + String getTitle()
        + String getSourceIp()
        + SeverityLevel getSeverity()
        + int getThreatScore()
        + String getStatus()
        + void setStatus(String status)
        + LocalDateTime getTimestamp()
        + void setTimestamp(LocalDateTime timestamp)
        + String toString()
    }
}

package filter {
    interface LogFilter {
        + void setNextFilter(LogFilter nextFilter)
        + Incident process(LogEntry log)
    }

    abstract class AbstractLogFilter {
        # LogFilter nextFilter
        + void setNextFilter(LogFilter nextFilter)
        # Incident checkNext(LogEntry log)
    }

    class IpBlacklistFilter {
        - Set<String> blacklistedIps
        + void addToBlacklist(String ip)
        + Incident process(LogEntry log)
    }

    class BruteForceFilter {
        - Map<String, List<Long>> failureTimestamps
        - {static} int THRESHOLD = 3
        - {static} long TIME_WINDOW_MS = 60000
        + Incident process(LogEntry log)
    }
}

package observer {
    interface AlertObserver {
        + void update(Incident incident)
    }

    class AlertPublisher {
        - List<AlertObserver> observers
        + void attach(AlertObserver observer)
        + void detach(AlertObserver observer)
        + void notifyObservers(Incident incident)
    }

    class AnalystNotifier {
        - String analystName
        - Incident lastNotifiedIncident
        - int notificationCount
        + AnalystNotifier(String analystName)
        + void update(Incident incident)
        + Incident getLastNotifiedIncident()
        + int getNotificationCount()
    }
}

package repository {
    interface IRepository<T> {
        + void saveAll(List<T> items)
        + List<T> loadAll()
    }

    class FileRepository {
        - final String filePath = "incidents.txt"
        + void saveAll(List<Incident> incidents)
        + List<Incident> loadAll()
    }
}

package service {
    class IncidentPriorityQueue {
        - PriorityQueue<Incident> priorityQueue
        + IncidentPriorityQueue()
        + void addIncident(Incident incident)
        + Incident pollIncident()
        + boolean isEmpty()
        + List<Incident> getAllIncidentsOrdered()
    }

    class ContainmentService {
        - Set<String> blockedIps
        + void blockIp(String ip)
        + boolean isIpBlocked(String ip)
        + Set<String> getBlockedIps()
    }

    class IncidentResponseService {
        - ContainmentService containmentService
        - IRepository<Incident> repository
        + IncidentResponseService(ContainmentService containmentService, IRepository<Incident> repository)
        + void updateIncidentStatus(Incident incident, String newStatus)
        + void saveCurrentState(List<Incident> incidents)
    }

    class SIEMEngine {
        - LogFilter filterChain
        - IRepository<Incident> repository
        - AlertPublisher alertPublisher
        - IncidentPriorityQueue priorityQueue
        - ContainmentService containmentService
        - IncidentResponseService responseService
        - List<Incident> allIncidents
        + SIEMEngine(LogFilter filterChain, IRepository<Incident> repository)
        + void processLog(LogEntry log)
        + ContainmentService getContainmentService()
        + IncidentResponseService getResponseService()
        + AlertPublisher getAlertPublisher()
        + IncidentPriorityQueue getPriorityQueue()
        + void shutdown()
    }
}

' Interface ve kalitim iliskileri
AbstractLogFilter ..|> LogFilter
IpBlacklistFilter --|> AbstractLogFilter
BruteForceFilter --|> AbstractLogFilter
AnalystNotifier ..|> AlertObserver
FileRepository ..|> IRepository : implements

' Chain of Responsibility
AbstractLogFilter --> LogFilter : nextFilter

' Observer Pattern
AlertPublisher o-- AlertObserver : observers

' Model iliskileri
Incident --> SeverityLevel : severity

' SIEMEngine bagimliliklari
SIEMEngine --> LogFilter : filterChain
SIEMEngine --> IRepository : repository
SIEMEngine --> AlertPublisher : alertPublisher
SIEMEngine --> IncidentPriorityQueue : priorityQueue
SIEMEngine --> ContainmentService : containmentService
SIEMEngine --> IncidentResponseService : responseService
SIEMEngine --> Incident : allIncidents
SIEMEngine ..> LogEntry : processes

' Incident response iliskileri
IncidentResponseService --> ContainmentService
IncidentResponseService --> IRepository

@enduml
